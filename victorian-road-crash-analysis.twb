          </datasources>
          <datasource-dependencies datasource='federated.01e1ob91dnk9zs1cwvgoq1v3jqbi'>
            <column caption='3hr Time Frame' datatype='string' name='[Calculation_442760138716594182]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF FLOOR(DATEPART(&apos;hour&apos;, [accident_time]) / 3) = 0 THEN &apos;12 AM - 3 AM&apos;&#13;&#10;ELSEIF FLOOR(DATEPART(&apos;hour&apos;, [accident_time]) / 3) = 1 THEN &apos;3 AM - 6 AM&apos;&#13;&#10;ELSEIF FLOOR(DATEPART(&apos;hour&apos;, [accident_time]) / 3) = 2 THEN &apos;6 AM - 9 AM&apos;&#13;&#10;ELSEIF FLOOR(DATEPART(&apos;hour&apos;, [accident_time]) / 3) = 3 THEN &apos;9 AM - 12 PM&apos;&#13;&#10;ELSEIF FLOOR(DATEPART(&apos;hour&apos;, [accident_time]) / 3) = 4 THEN &apos;12 PM - 3 PM&apos;&#13;&#10;ELSEIF FLOOR(DATEPART(&apos;hour&apos;, [accident_time]) / 3) = 5 THEN &apos;3 PM - 6 PM&apos;&#13;&#10;ELSEIF FLOOR(DATEPART(&apos;hour&apos;, [accident_time]) / 3) = 6 THEN &apos;6 PM - 9 PM&apos;&#13;&#10;ELSEIF FLOOR(DATEPART(&apos;hour&apos;, [accident_time]) / 3) = 7 THEN &apos;9 PM - 12 AM&apos;&#13;&#10;END' />
            </column>
            <column caption='Accident No' datatype='string' name='[accident_no]' role='dimension' type='nominal' />
            <column caption='Accident Time' datatype='datetime' name='[accident_time]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_442760138716594182]' derivation='None' name='[none:Calculation_442760138716594182:nk]' pivot='key' type='nominal' />
            <column-instance column='[accident_no]' derivation='Count' name='[pcto:cnt:accident_no:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' type='PctTotal' />
            </column-instance>
            <column-instance column='[accident_time]' derivation='Quarter' name='[qr:accident_time:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <manual-sort column='[federated.01e1ob91dnk9zs1cwvgoq1v3jqbi].[none:Calculation_442760138716594182:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;12 AM - 3 AM&quot;</bucket>
              <bucket>&quot;3 AM - 6 AM&quot;</bucket>
              <bucket>&quot;6 AM - 9 AM&quot;</bucket>
              <bucket>&quot;9 AM - 12 PM&quot;</bucket>
              <bucket>&quot;12 PM - 3 PM&quot;</bucket>
              <bucket>&quot;3 PM - 6 PM&quot;</bucket>
