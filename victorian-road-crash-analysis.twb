      <aliases enabled='yes' />
      <column caption='3hr Time Frame' datatype='string' name='[Calculation_442760138716594182]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF FLOOR(DATEPART(&apos;hour&apos;, [accident_time]) / 3) = 0 THEN &apos;12 AM - 3 AM&apos;&#13;&#10;ELSEIF FLOOR(DATEPART(&apos;hour&apos;, [accident_time]) / 3) = 1 THEN &apos;3 AM - 6 AM&apos;&#13;&#10;ELSEIF FLOOR(DATEPART(&apos;hour&apos;, [accident_time]) / 3) = 2 THEN &apos;6 AM - 9 AM&apos;&#13;&#10;ELSEIF FLOOR(DATEPART(&apos;hour&apos;, [accident_time]) / 3) = 3 THEN &apos;9 AM - 12 PM&apos;&#13;&#10;ELSEIF FLOOR(DATEPART(&apos;hour&apos;, [accident_time]) / 3) = 4 THEN &apos;12 PM - 3 PM&apos;&#13;&#10;ELSEIF FLOOR(DATEPART(&apos;hour&apos;, [accident_time]) / 3) = 5 THEN &apos;3 PM - 6 PM&apos;&#13;&#10;ELSEIF FLOOR(DATEPART(&apos;hour&apos;, [accident_time]) / 3) = 6 THEN &apos;6 PM - 9 PM&apos;&#13;&#10;ELSEIF FLOOR(DATEPART(&apos;hour&apos;, [accident_time]) / 3) = 7 THEN &apos;9 PM - 12 AM&apos;&#13;&#10;END' />
      </column>
      <column datatype='string' name='[Severity (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[severity]' new-bin='true'>
          <bin default-name='true' value='&quot;Null, Fatal accident, Non injury accident and 2 more&quot;'>
            <value>%null%</value>
            <value>&quot;Fatal accident&quot;</value>
            <value>&quot;Non injury accident&quot;</value>
            <value>&quot;Other injury accident&quot;</value>
            <value>&quot;Serious injury accident&quot;</value>
          </bin>
        </calculation>
      </column>
