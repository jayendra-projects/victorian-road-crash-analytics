    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Introduction'>
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='6' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98000' id='5' type-v2='text' w='98400' x='800' y='1000'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='24'>Introduction</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Analysis of Road Safety Trends in Victoria </run>
              <run fontalignment='1'>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' italic='true'>Presenter:</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> Jayendra Weerakoon, Consultant, Transport Accident Commission (TAC) </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' italic='true'>Objective/Purpose:</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> Presentation aims to illuminate the current trends and patterns in road accidents across Victoria, employing a comprehensive analysis of secondary data. The goal is to identify key risk factors and propose data-driven strategies to enhance road safety measures and reduce accident rates. </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' italic='true'>Audience:</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> Victorian Government officials, particularly from the departments focused on road safety, public health, and transport infrastructure. </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' italic='true'>Ethical Considerations:</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> Analysis utilizes secondary data sourced from Victoria Police and hospital records, rigorously processed and anonymized to ensure privacy and compliance, while meticulous documentation and unbiased methods uphold transparency, reproducibility, and accuracy in revealing insights into Victoria&apos;s road safety trends. </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' italic='true'>Contents of the Presentation:</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Æ </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>1. Overview of Road Accidents and Trends </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>2. Temporal Trends in Road Accidents </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>3. Risk Analysis of Road Accidents </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>4. Recommendations </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>5. Rationale Behind the Used Visualizations </run>
              <run>Æ&#10;&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone h='21375' id='37' is-centered='0' is-scaled='1' param='Image/TAC.png' type-v2='bitmap' w='33400' x='60800' y='63500' />
      </zones>
